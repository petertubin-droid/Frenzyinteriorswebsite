# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Access (for seeding)
ADMIN_EMAIL=admin@frenzyinteriors.com
ADMIN_PASSWORD=Admin123456!

# Google AdSense (optional)
# Get your Client ID from AdSense: https://www.google.com/adsense
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Meta (Facebook) Pixel (optional)
# Get your Pixel ID from Meta Events Manager: https://business.facebook.com/events_manager
NEXT_PUBLIC_META_PIXEL_ID=
